# No DRM: the official 5.10 kernels (all but geminilakenk, whose own i915
# is official) are built without DMA_SHARED_BUFFER, HDMI and SYNC_FILE,
# bools that would have to be in vmlinux for drm.ko to load. GPU drivers
# for them need a backport that carries its own dma-buf (see README).

# Synology's virtio-scsi "device" mode, defaulted on with SCSI_VIRTIO; off as
# in dsm_linux_fix, it is not part of the official kernels.
CONFIG_SYNO_VIRTIO_SCSI_DEVICE=n

# On-demand paging selects HMM_MIRROR, mm/ code the official vmlinux lacks.
CONFIG_INFINIBAND_ON_DEMAND_PAGING=n

# What the prebuilt set had; the configuration check decides. TPROXY and
# socket matching need udp4_lib_lookup, which only a kernel built with them
# exports; typec, gpio-charger and pwm-fan need POWER_SUPPLY, REGULATOR,
# EXTCON or PWM, core bools the official kernels have off. Where that is so
# the report says it, and nothing changes the official kernel.
CONFIG_NF_SOCKET_IPV4=m
CONFIG_NF_SOCKET_IPV6=m
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NF_TPROXY_IPV6=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_TYPEC=m
CONFIG_TYPEC_TCPM=m
CONFIG_TYPEC_FUSB302=m
CONFIG_TYPEC_HD3SS3220=m
CONFIG_CHARGER_GPIO=m
CONFIG_SENSORS_PWM_FAN=m
