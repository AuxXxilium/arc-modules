usb: typec: tcpm: build without the power-supply class

TYPEC_TCPM selects POWER_SUPPLY, a bool the official kernels have off, so
TCPM and the port controllers on it (fusb302, tcpci) were turned off. Without
the class the port registers no power supply (the "tcpm-source-psy-*" sysfs
entry); Type-C/PD negotiation is unchanged.

--- a/drivers/usb/typec/tcpm/Kconfig
+++ b/drivers/usb/typec/tcpm/Kconfig
@@ -4,7 +4,6 @@
 	tristate "USB Type-C Port Controller Manager"
 	depends on USB
 	select USB_ROLE_SWITCH
-	select POWER_SUPPLY
 	help
 	  The Type-C Port Controller Manager provides a USB PD and USB Type-C
 	  state machine for use with Type-C Port Controllers.
--- a/drivers/usb/typec/tcpm/tcpm.c
+++ b/drivers/usb/typec/tcpm/tcpm.c
@@ -32,6 +32,17 @@
 #include <linux/usb/typec_altmode.h>
 
 #include <uapi/linux/sched/types.h>
+
+#if !IS_ENABLED(CONFIG_POWER_SUPPLY)
+/*
+ * arc-modules: the official kernels have no power-supply class; the port
+ * registers no "tcpm-source-psy" supply, the rest of TCPM is unchanged.
+ */
+#define devm_power_supply_register(dev, desc, cfg) ((struct power_supply *)NULL)
+#define power_supply_changed(psy) do { } while (0)
+#define power_supply_get_drvdata(psy) ((void *)NULL)
+#endif
+
 
 #define FOREACH_STATE(S)			\
 	S(INVALID_STATE),			\
