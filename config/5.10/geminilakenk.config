# geminilakenk: the official kernel has DRM (drm, drm_kms_helper and i915 are
# official modules). They are rebuilt from the same source here and ship
# (geminilakenk.list), with the GEM shmem/CMA helpers inside drm.ko that
# virtio-gpu, udl and arcpgu need, the way the prebuilt set had them; the
# backport's i915 stack ships in update/ (src/drm-backport-update). amdgpu
# is built in-tree, display core off: headless, and DC drags in far more
# than transcoding needs; with the Southern Islands and Sea Islands parts
# (bools inside amdgpu) the prebuilt amdgpu bound.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=n
CONFIG_DRM_AMD_DC=n

# Virtual, USB and SoC display drivers the prebuilt set had.
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_UDL=m
CONFIG_DRM_ARCPGU=m
