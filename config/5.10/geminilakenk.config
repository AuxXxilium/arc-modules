# geminilakenk: the official kernel has DRM (and its own i915, which DSM
# loads). amdgpu is built in-tree against it, on DSM's drm.ko; the backport
# (src/drm-backport) is not built here. Display core off: headless, and
# DC drags in far more than transcoding needs.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=n
CONFIG_DRM_AMDGPU_CIK=n
CONFIG_DRM_AMDGPU_USERPTR=n
CONFIG_DRM_AMD_DC=n
