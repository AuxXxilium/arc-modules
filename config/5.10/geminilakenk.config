# geminilakenk: the official kernel has DRM (drm, drm_kms_helper and i915 are
# official modules). They are rebuilt from the same source here and ship
# (geminilakenk.list), with the GEM shmem/CMA helpers inside drm.ko that
# virtio-gpu, udl and arcpgu need, the way the prebuilt set had them; the
# backport (src/drm-backport) is not built here. amdgpu is built in-tree,
# display core off: headless, and DC drags in far more than transcoding
# needs.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=n
CONFIG_DRM_AMDGPU_CIK=n
CONFIG_DRM_AMDGPU_USERPTR=n
CONFIG_DRM_AMD_DC=n

# Virtual, USB and SoC display drivers the prebuilt set had.
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_UDL=m
CONFIG_DRM_ARCPGU=m
