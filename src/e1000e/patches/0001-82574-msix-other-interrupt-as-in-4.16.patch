e1000e: 82574 MSI-X "Other" interrupt as in Linux 4.16

3.8.7 treats every interrupt on the "Other" vector as a possible link
change: it schedules a link check each time, and Other is in the
auto-clear mask, so its handler never learns the cause. On QEMU's
emulated 82574 (and per the upstream reports on real ones) that is an
interrupt storm in which the link goes up and down every few
milliseconds, so MSI-X (the default) has no usable link. Upstream fixed
it in 4.16 ("e1000e: Remove Other from EIAC", "e1000e: Fix queue
interrupt re-raising in Other interrupt", "e1000e: Avoid missed
interrupts following ICR read"); these are those changes: Other leaves
EIAC, its handler reads ICR, re-raises queue causes and checks the link
only on LSC.

--- a/src/netdev.c
+++ b/src/netdev.c
@@ -2118,14 +2118,22 @@
 	struct net_device *netdev = data;
 	struct e1000_adapter *adapter = netdev_priv(netdev);
 	struct e1000_hw *hw = &adapter->hw;
-
-	hw->mac.get_link_status = true;
-
-	/* guard against interrupt when we're going down */
-	if (!test_bit(__E1000_DOWN, &adapter->state)) {
-		mod_timer(&adapter->watchdog_timer, jiffies + 1);
-		ew32(IMS, E1000_IMS_OTHER);
-	}
+	u32 icr = er32(ICR);
+
+	/* queue causes that ended up here are raised again on their vector */
+	if (icr & adapter->eiac_mask)
+		ew32(ICS, (icr & adapter->eiac_mask));
+
+	/* only a link status change asks for a link check */
+	if (icr & E1000_ICR_LSC) {
+		hw->mac.get_link_status = true;
+		/* guard against interrupt when we're going down */
+		if (!test_bit(__E1000_DOWN, &adapter->state))
+			mod_timer(&adapter->watchdog_timer, jiffies + 1);
+	}
+
+	if (!test_bit(__E1000_DOWN, &adapter->state))
+		ew32(IMS, E1000_IMS_OTHER | E1000_IMS_LSC);
 
 	return IRQ_HANDLED;
 }
@@ -2249,7 +2257,7 @@
 		       hw->hw_addr + E1000_EITR_82574(vector));
 	else
 		writel(1, hw->hw_addr + E1000_EITR_82574(vector));
-	adapter->eiac_mask |= E1000_IMS_OTHER;
+	/* Other stays out of the auto-clear mask: its handler reads ICR */
 
 	/* Cause Tx interrupts on every write back */
 	ivar |= BIT(31);
@@ -2471,7 +2479,7 @@
 
 	if (adapter->msix_entries) {
 		ew32(EIAC_82574, adapter->eiac_mask & E1000_EIAC_MASK_82574);
-		ew32(IMS, adapter->eiac_mask | E1000_IMS_LSC);
+		ew32(IMS, adapter->eiac_mask | E1000_IMS_OTHER | E1000_IMS_LSC);
 	} else if (hw->mac.type >= e1000_pch_lpt) {
 		ew32(IMS, IMS_ENABLE_MASK | E1000_IMS_ECCER);
 	} else {
